generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Use the DATABASE_URL from your .env file
// Example in .env: DATABASE_URL="postgresql://user:pass@host:5432/dbname"
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Your models
model Notes {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  createdAt DateTime @default(now())
}
