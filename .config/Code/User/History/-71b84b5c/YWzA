CXX = g++
CXXFLAGS = -std=c++17 -O2 -Wall -Iinclude

SRC = src/backend.cpp src/cache.cpp src/epoll_handler.cpp src/http_parser.cpp \
      src/load_balancer.cpp src/logger.cpp src/main.cpp src/server.cpp src/threadpool.cpp
	  src/threadpool.o


OBJ = $(SRC:.cpp=.o)

BIN = bin/reverse-proxy

all: $(BIN)

$(BIN): $(OBJ)
	mkdir -p bin
	$(CXX) $(CXXFLAGS) -o $(BIN) $(OBJ)

clean:
	rm -f src/*.o $(BIN)
