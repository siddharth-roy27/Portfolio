package main

import (
	"context"
	"flag"
	"log"
	"net"
	"strings"
	"time"

	"google.golang.org/grpc"

	"github.com/siddharth-roy27/distributed-kv-store/internal/raft"
	pb "github.com/siddharth-roy27/distributed-kv-store/proto/kv"
	raftpb "github.com/siddharth-roy27/distributed-kv-store/proto/raft"
)

// In-memory KV store (simple)
var store = make(map[string]string)

type server struct {
	pb.UnimplementedKVServer
	raftNode *raft.RaftNode
}

func (s *server) Get(ctx context.Context, req *pb.GetRequest) (*pb.GetResponse, error) {
	v, ok := store[req.Key]
	return &pb.GetResponse{Value: v, Found: ok}, nil
}

func (s *server) Set(ctx context.Context, req *pb.SetRequest) (*pb.SetResponse, error) {
	store[req.Key] = req.Value
	return &pb.SetResponse{Success: true}, nil
}

func main() {
	id := flag.String("id", "node1", "node id")
	raftPort := flag.String("raft-port", "8001", "Raft peer port")
	kvPort := flag.String("grpc-port", "50051", "KV gRPC port")
	peers := flag.String("peers", "", "comma-separated list of peer addresses (host:port or port)")
	flag.Parse()

	// normalize peers
	peerAddrs := []string{}
	if *peers != "" {
		for _, p := range strings.Split(*peers, ",") {
			t := strings.TrimSpace(p)
			if t == "" {
				continue
			}
			if !strings.Contains(t, ":") {
				t = "localhost:" + t
			}
			peerAddrs = append(peerAddrs, t)
		}
	}

	kvAddr := ":" + *kvPort
	raftAddr := ":" + *raftPort

	rn := &raft.RaftNode{ID: *id}
	rn.StartRaft()
	log.Printf("Raft node %s started", rn.ID)

	// dial peers
	for _, a := range peerAddrs {
		go func(addr string) {
			for i := 0; i < 5; i++ {
				pc, err := raft.NewPeerClient(addr)
				if err == nil {
					log.Printf("connected to peer %s", addr)
					_ = pc
					return
				}
				log.Printf("peer connect %s failed: %v", addr, err)
				time.Sleep(300 * time.Millisecond)
			}
			log.Printf("giving up on %s", addr)
		}(a)
	}

	// KV server
	lisKV, err := net.Listen("tcp", kvAddr)
	if err != nil {
		log.Fatalf("listen kv %s: %v", kvAddr, err)
	}
	kvServer := grpc.NewServer()
	pb.RegisterKVServer(kvServer, &server{raftNode: rn})

	// Raft server
	lisRaft, err := net.Listen("tcp", raftAddr)
	if err != nil {
		log.Fatalf("listen raft %s: %v", raftAddr, err)
	}
	raftServer := grpc.NewServer()
	raftService := raft.NewRaftService(rn)
	raftpb.RegisterRaftServer(raftServer, raftService)

	log.Printf("listening kv=%s raft=%s peers=%v", kvAddr, raftAddr, peerAddrs)

	go func() {
		if err := kvServer.Serve(lisKV); err != nil {
			log.Fatalf("kv serve: %v", err)
		}
	}()

	if err := raftServer.Serve(lisRaft); err != nil {
		log.Fatalf("raft serve: %v", err)
	}
}
